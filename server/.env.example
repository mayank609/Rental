# =============================================================================
# RentNest — environment variables (server). Copy to `.env` (root, for docker
# compose) and/or `server/.env` (local dev). Never commit real secrets.
# Required in production are marked [REQUIRED].
# =============================================================================

# --- App ---------------------------------------------------------------------
NODE_ENV=development                      # development | test | production
PORT=4000
PLATFORM_NAME=RentNest                    # Brand name used in emails, invoices, SEO
APP_URL=http://localhost:5173             # [REQUIRED] Public URL of the web app (links in emails, sitemap, canonical URLs)
API_URL=http://localhost:4000             # [REQUIRED] Public URL of this API (upload URLs, docs)
CORS_ORIGINS=http://localhost:5173        # [REQUIRED] Comma-separated allowed browser origins
COUNTRY_CODE=IN
CURRENCY=INR
DEFAULT_TIMEZONE=Asia/Kolkata             # Display TZ for invoices/notifications (data is stored in UTC)

# --- Database & cache --------------------------------------------------------
DATABASE_URL=postgresql://rental:rental@localhost:5432/rental   # [REQUIRED] PostgreSQL 14+ with PostGIS
REDIS_URL=redis://localhost:6379          # [REQUIRED in prod] cache, rate limits, OTPs, BullMQ, socket.io adapter
REDIS_DISABLED=false                      # true = in-memory fallback (tests only)
RUN_WORKERS_IN_API=true                   # false when running a separate `worker` process (recommended in prod)

# --- Auth & security ---------------------------------------------------------
JWT_ACCESS_SECRET=change-me-to-a-64-char-random-string          # [REQUIRED] openssl rand -hex 32
JWT_REFRESH_SECRET=change-me-to-another-64-char-random-string   # [REQUIRED]
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_DOMAIN=                            # e.g. .rentnest.in when API and web share a parent domain
COOKIE_SAMESITE=lax                       # lax (same-site API) | none (API on a different site; requires HTTPS)
DATA_ENCRYPTION_KEY=                      # [REQUIRED] 64 hex chars (openssl rand -hex 32) — encrypts bank account numbers
OTP_TTL_SECONDS=300
OTP_DEV_ECHO=false                        # true returns OTP codes in API responses (dev only; refused in production)
GOOGLE_CLIENT_ID=                         # Google Identity Services OAuth client id (enables "Sign in with Google")

# --- Payments (Razorpay Route) -----------------------------------------------
PAYMENT_PROVIDER=mock                     # razorpay | mock
RAZORPAY_KEY_ID=                          # [REQUIRED for razorpay] rzp_live_xxx
RAZORPAY_KEY_SECRET=                      # [REQUIRED for razorpay]
RAZORPAY_WEBHOOK_SECRET=                  # [REQUIRED for razorpay] webhook URL: {API_URL}/api/v1/webhooks/razorpay
RAZORPAY_ACCOUNT_NUMBER=                  # RazorpayX account (optional, for payouts reporting)

# --- Storage (S3-compatible: AWS S3, Cloudflare R2, MinIO, DO Spaces) ---------
S3_BUCKET=                                # empty = local disk (./uploads) — NOT for production
S3_REGION=ap-south-1
S3_ENDPOINT=                              # e.g. https://<account>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=                            # CDN/public base URL for the bucket, e.g. https://cdn.rentnest.in
S3_FORCE_PATH_STYLE=false                 # true for MinIO
LOCAL_UPLOAD_DIR=uploads

# --- Maps & geocoding --------------------------------------------------------
GEOCODER=nominatim                        # google | mapbox | nominatim (free, rate-limited) | offline (tests)
GOOGLE_MAPS_API_KEY=                      # when GEOCODER=google (Geocoding API)
MAPBOX_TOKEN=                             # when GEOCODER=mapbox
IP_GEO_URL=http://ip-api.com/json         # IP → city fallback when browser geolocation is denied

# --- Notifications -----------------------------------------------------------
SMTP_URL=                                 # smtps://user:pass@smtp.provider.com:465 (empty = log to console)
EMAIL_FROM=RentNest <no-reply@rentnest.in>
SMS_PROVIDER=console                      # console | msg91 | twilio
MSG91_AUTH_KEY=                           # MSG91 (DLT-registered templates required in India)
MSG91_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=                              # SMS sender number
TWILIO_WHATSAPP_FROM=                     # WhatsApp-enabled sender, e.g. +14155238886
VAPID_PUBLIC_KEY=                         # Web push: npx web-push generate-vapid-keys
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@rentnest.in

# --- Observability -----------------------------------------------------------
LOG_LEVEL=info
SENTRY_DSN=

# --- Company details printed on GST invoices ---------------------------------
COMPANY_LEGAL_NAME=RentNest Technologies Pvt. Ltd.
COMPANY_GSTIN=29ABCDE1234F1Z5
COMPANY_ADDRESS=Bengaluru, Karnataka, India
SUPPORT_EMAIL=support@rentnest.in

# --- Single-service deploy ---------------------------------------------------
SERVE_CLIENT_DIR=                         # path to client/dist to serve the SPA (with SEO meta injection) from the API
