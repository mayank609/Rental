# RentNest web app (Vite). Copy to client/.env.local
VITE_API_URL=                     # API origin, e.g. https://api.rentnest.in (empty = same origin / dev proxy)
VITE_PLATFORM_NAME=RentNest       # Brand name shown in the UI
VITE_MAPBOX_TOKEN=                # Optional: Mapbox tiles (defaults to OpenStreetMap tiles)
VITE_DEV_API_PROXY=http://localhost:4000   # Dev server proxy target
