{
  "name": "rentnest",
  "private": true,
  "version": "1.0.0",
  "description": "RentNest \u2014 peer-to-peer rental marketplace (monorepo)",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "node api.js && npm run dev --workspaces --if-present",
    "build": "node api.js && npm run build -w server && npm run build -w client",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "@types/express-serve-static-core": "5.0.6"
  }
}
